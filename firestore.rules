rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin: sadece bu e-posta(lar) panelden yazabilir ──────────────
    // Firebase'e kayıt olan HERHANGİ biri değil, yalnızca listedeki hesap.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['dc.tnrvrdi@gmail.com'];
    }

    function validStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ── Herkese açık okunan site içeriği ─────────────────────────────
    match /siteConfig/{doc}     { allow read: if true; allow write: if isAdmin(); }
    match /menuCategories/{doc} { allow read: if true; allow write: if isAdmin(); }
    match /menuItems/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /addons/{doc}         { allow read: if true; allow write: if isAdmin(); }

    // ── İletişim formu: herkes yazar, sadece admin okur ──────────────
    match /messages/{doc} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'createdAt', 'read'])
                    && validStr(request.resource.data.name, 1, 99)
                    && validStr(request.resource.data.email, 4, 199)
                    && validStr(request.resource.data.message, 1, 1999)
                    && (!('phone' in request.resource.data) || validStr(request.resource.data.phone, 0, 40))
                    && (!('read' in request.resource.data) || request.resource.data.read == false)
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ── Bülten: herkes kendini ekler, kimse başkasını okuyamaz ───────
    match /subscribers/{email} {
      allow create: if request.resource.data.keys().hasAll(['email', 'subscribedAt'])
                    && request.resource.data.keys().hasOnly(['name', 'email', 'birthDate', 'subscribedAt', 'source', 'consent', 'consentAt', 'consentVer', 'unsubToken'])
                    && validStr(request.resource.data.unsubToken, 24, 64)
                    && request.resource.data.consent == true
                    && request.resource.data.consentAt == request.time
                    && validStr(request.resource.data.consentVer, 1, 40)
                    && validStr(request.resource.data.email, 4, 199)
                    && email == request.resource.data.email.lower()
                    && (!('name' in request.resource.data) || validStr(request.resource.data.name, 0, 100))
                    && (!('birthDate' in request.resource.data) || validStr(request.resource.data.birthDate, 0, 20))
                    && (!('source' in request.resource.data) || validStr(request.resource.data.source, 0, 20))
                    && request.resource.data.subscribedAt == request.time;
      allow read, delete: if isAdmin();
      // Abonelikten çıkma: maildeki gizli anahtarı bilen, sadece onayı kapatabilir
      allow update: if isAdmin()
                    || (('unsubToken' in resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent', 'unsubscribedAt', 'unsubProof'])
                        && request.resource.data.consent == false
                        && request.resource.data.unsubscribedAt == request.time
                        && request.resource.data.unsubProof == resource.data.unsubToken);
    }

    // ── Ziyaret sayacı: sadece +1 artırılabilir ────────────────────
    function pages() { return ['home', 'menu', 'space', 'contact']; }

    function oneOrAbsent(k) {
      return request.resource.data.get(k, 1) == 1;
    }

    function sameOrPlusOne(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
          || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }

    match /analytics/{day} {
      allow read, delete: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(pages())
                    && request.resource.data.size() == 1
                    && oneOrAbsent('home') && oneOrAbsent('menu')
                    && oneOrAbsent('space') && oneOrAbsent('contact');
      allow update: if request.resource.data.keys().hasOnly(pages())
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && sameOrPlusOne('home') && sameOrPlusOne('menu')
                    && sameOrPlusOne('space') && sameOrPlusOne('contact');
    }

    // ── Ziyaretçi kaynağı ve yeni/tekrar (günlük, sadece +1) ─────────
    match /analyticsSrc/{day} {
      allow read, delete: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(['qr', 'ig', 'google', 'wa', 'fb', 'diger', 'direkt', 'yeni', 'tekrar'])
                    && request.resource.data.size() == 1
                    && oneOrAbsent('qr') && oneOrAbsent('ig') && oneOrAbsent('google') && oneOrAbsent('wa') && oneOrAbsent('fb')
                    && oneOrAbsent('diger') && oneOrAbsent('direkt') && oneOrAbsent('yeni') && oneOrAbsent('tekrar');
      allow update: if request.resource.data.keys().hasOnly(['qr', 'ig', 'google', 'wa', 'fb', 'diger', 'direkt', 'yeni', 'tekrar'])
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && sameOrPlusOne('qr') && sameOrPlusOne('ig') && sameOrPlusOne('google') && sameOrPlusOne('wa') && sameOrPlusOne('fb')
                    && sameOrPlusOne('diger') && sameOrPlusOne('direkt') && sameOrPlusOne('yeni') && sameOrPlusOne('tekrar');
    }

    // ── Ürün/kategori ilgisi (aylık; g = görüldü, a = fotoğraf açıldı) ─
    match /interest/{month}/c/{key} {
      allow read, delete: if isAdmin();
      allow create: if month.matches('^[0-9]{4}-[0-9]{2}$')
                    && key.matches('^[ik]_[A-Za-z0-9_-]{1,60}$')
                    && request.resource.data.keys().hasOnly(['g', 'a'])
                    && request.resource.data.size() == 1
                    && oneOrAbsent('g') && oneOrAbsent('a');
      allow update: if request.resource.data.keys().hasOnly(['g', 'a'])
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && sameOrPlusOne('g') && sameOrPlusOne('a');
    }

    // ── Saatlik ziyaret sayacı (ör. 2026-10-13-14): aynı kurallar ──
    match /analyticsHourly/{hour} {
      allow read, delete: if isAdmin();
      allow create: if hour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.keys().hasOnly(pages())
                    && request.resource.data.size() == 1
                    && oneOrAbsent('home') && oneOrAbsent('menu')
                    && oneOrAbsent('space') && oneOrAbsent('contact');
      allow update: if request.resource.data.keys().hasOnly(pages())
                    && request.resource.data.diff(resource.data).affectedKeys().size() == 1
                    && sameOrPlusOne('home') && sameOrPlusOne('menu')
                    && sameOrPlusOne('space') && sameOrPlusOne('contact');
    }
  }
}
